# Railway Environment Variables Template
# Railway auto-provides MySQL variables, you just need to add:
SPRING_PROFILES_ACTIVE=railway
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-64-characters-long
PORT=4040
# Optional: AWS S3 for file uploads
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
# MySQL variables are automatically provided by Railway:
# MYSQLHOST=<auto-provided>
# MYSQLPORT=<auto-provided>
# MYSQLDATABASE=<auto-provided>
# MYSQLUSER=<auto-provided>
# MYSQLPASSWORD=<auto-provided>
# MYSQLURL=<auto-provided>
