# Frontend .env Configuration for Sitara Hotel Backend

# Copy this file to your frontend project as .env
# Replace the framework-specific variable name based on what you're using

# ============================================================
# BACKEND API URL (Your deployed Render backend)
# ============================================================

# For Create React App:
REACT_APP_API_URL=https://sitara-hotel-backend.onrender.com

# For Vite (React/Vue):
VITE_API_URL=https://sitara-hotel-backend.onrender.com

# For Next.js:
NEXT_PUBLIC_API_URL=https://sitara-hotel-backend.onrender.com

# For Angular:
NG_APP_API_URL=https://sitara-hotel-backend.onrender.com

# ============================================================
# USAGE IN FRONTEND CODE
# ============================================================

# React (Create React App):
# const API_URL = process.env.REACT_APP_API_URL;

# Vite:
# const API_URL = import.meta.env.VITE_API_URL;

# Next.js:
# const API_URL = process.env.NEXT_PUBLIC_API_URL;

# ============================================================
# EXAMPLE API CALLS
# ============================================================

# Login:
# fetch(`${API_URL}/auth/login`, {
#   method: 'POST',
#   headers: { 'Content-Type': 'application/json' },
#   body: JSON.stringify({ email: 'admin@sitara.com', password: 'admin123' })
# })

# Get Rooms:
# fetch(`${API_URL}/rooms/all`)

# ============================================================
# IMPORTANT NOTES
# ============================================================

# 1. After creating this file, restart your frontend dev server
# 2. Free tier sleeps after 15 min - first request may take 30-60s
# 3. Use UptimeRobot to keep it awake: https://uptimerobot.com
# 4. NEVER commit this file to GitHub (add to .gitignore)

